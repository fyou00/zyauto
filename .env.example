FAKE_TOPAZ=1
FAKE_TOPAZ_DELAY_SEC=5
TOPAZ_TIMEOUT_SEC=1500
TOPAZ_FFMPEG_PATH=
TVAI_MODEL_DIR=
TVAI_MODEL_DATA_DIR=
TOPAZ_FILTER=
AE_AERENDER_PATH=
# FAKE_AE=1 dan FAKE_HANDBRAKE=1 wajib saat dev di Mac. Kosongkan di Windows (produksi).
FAKE_AE=
FAKE_AE_DELAY_SEC=5
FAKE_HANDBRAKE=
FAKE_HANDBRAKE_DELAY_SEC=5
AE_COMP_NAME=
AE_OM_TEMPLATE=
# Folder file .aep. Kosong = <repo>/presets. File .aep tidak di-commit (presets/ di .gitignore).
AE_PRESET_DIR=
# Folder kerja AE: hasil Topaz disalin ke sini sebagai input<ext> sebelum aerender.
# Kosong = <repo>/data/ae_work. Nama input di .aep harus "input" (placeholder footage).
AE_WORK_DIR=
HANDBRAKE_CLI_PATH=
HANDBRAKE_PRESET_FILE=
HANDBRAKE_PRESET_NAME=
# Kolom "Waktu render" di daftar job. HANYA untuk testing. Kosongkan/hapus di produksi.
SHOW_RENDER_TIME=1